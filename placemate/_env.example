PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string
# If you get 'Could not connect to any servers', add your IP in Atlas > Network Access.
# Format: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/placementprep?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/placementprep?retryWrites=true&w=majority
SESSION_SECRET=change_this_to_a_long_random_string_in_production
SESSION_MAX_AGE=86400000
ADMIN_EMAIL=admin@placementprep.com
# Change this before seeding. Never reuse a real password.
ADMIN_PASSWORD=ChangeMe@12345
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

